---
import '../styles/global.css';

const { frontmatter } = Astro.props;
const pageTitle = frontmatter?.title ?? 'Rainbow Sicily Trek';
const title = pageTitle === 'Rainbow Sicily Trek'
  ? pageTitle
  : `${pageTitle} | Rainbow Sicily Trek`;

const description = frontmatter?.description ?? 'Rainbow Sicily Trek - Escursioni e natura in Sicilia';
const image = frontmatter?.image ?? '/og-image.jpg'; // Placeholder or default image

const basePath = import.meta.env.BASE_URL;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const isHome = frontmatter?.home === true;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigazione principale">
        <a class="brand" href={normalizedBasePath}>Rainbow Sicily Trek</a>
        {!isHome && <a class="back-link" href={normalizedBasePath} aria-label="Torna all'archivio">Archivio</a>}
      </nav>
    </header>

    <main class={isHome ? 'page page-home' : 'page page-post'}>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Rainbow Sicily Trek</p>
    </footer>
  </body>
</html>
