---
import '../styles/global.css';

const { frontmatter } = Astro.props;
const pageTitle = frontmatter?.title ?? 'Rainbow Sicily Trek';
const title = pageTitle === 'Rainbow Sicily Trek'
  ? pageTitle
  : `${pageTitle} | Rainbow Sicily Trek`;

const description = frontmatter?.description ?? 'Rainbow Sicily Trek - Escursioni e natura in Sicilia';
const image = frontmatter?.image ?? '/og-image.jpg'; // Placeholder or default image

const basePath = import.meta.env.BASE_URL;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const isHome = frontmatter?.home === true;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const dislivello = frontmatter?.dislivello;
const difficolta = frontmatter?.difficolta;
const distanza = frontmatter?.distanza;
const durata = frontmatter?.durata;
const durate = frontmatter?.durate;
const subtitle = frontmatter?.subtitle ?? (isHome ? '' : 'Rainbow Sicily Trek');

const hasMetadata = dislivello || difficolta || distanza || durata;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Search Engine -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="Navigazione principale">
        <a class="brand" href={normalizedBasePath}>Rainbow Sicily Trek</a>
        {!isHome && <a class="back-link" href={normalizedBasePath} aria-label="Torna all'archivio">Archivio</a>}
      </nav>
    </header>

    <main class={isHome ? 'page page-home' : 'page page-post'}>
      {!isHome && (
        <header class="post-header">
          {subtitle && <p class="post-subtitle">{subtitle}</p>}
          <h1 class="post-title">{pageTitle}</h1>
          
          {hasMetadata && (
            <div class="hike-metadata">
              {dislivello && (
                <div class="hike-metadata-item">
                  <div class="hike-metadata-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                    </svg>
                  </div>
                  <div class="hike-metadata-content">
                    <span class="hike-metadata-label">Dislivello</span>
                    <span class="hike-metadata-value">{dislivello}</span>
                  </div>
                </div>
              )}
              {difficolta && (
                <div class="hike-metadata-item">
                  <div class="hike-metadata-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
                      <line x1="4" y1="22" x2="4" y2="15"/>
                    </svg>
                  </div>
                  <div class="hike-metadata-content">
                    <span class="hike-metadata-label">Difficoltà</span>
                    <span class="hike-metadata-value">{difficolta}</span>
                  </div>
                </div>
              )}
              {distanza && (
                <div class="hike-metadata-item">
                  <div class="hike-metadata-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                  </div>
                  <div class="hike-metadata-content">
                    <span class="hike-metadata-label">Distanza</span>
                    <span class="hike-metadata-value">{distanza}</span>
                  </div>
                </div>
              )}
              {durata && (
                <div class="hike-metadata-item">
                  <div class="hike-metadata-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                  </div>
                  <div class="hike-metadata-content">
                    <span class="hike-metadata-label">Durata</span>
                    <span class="hike-metadata-value">{durata}</span>
                    {Array.isArray(durate) && durate.length > 0 && (
                      <div class="hike-metadata-details">
                        {durate.map(d => (
                          <div class="hike-metadata-detail-row">
                            <span class="detail-label">{d.label}</span>
                            <span class="detail-value">{d.value}</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          )}
        </header>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <p>Rainbow Sicily Trek</p>
    </footer>
  </body>
</html>
